<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Fiche Stratégie — Team_Up</title>
    <link rel="stylesheet" href="../style.css" />
    <script defer src="../script.js"></script>
  </head>
  <body class="fiche">
    <header class="fiche-header">
      <div class="inner">
        <a class="back-link" href="../index.html">← Retour à l’accueil</a>
        <h1 class="fiche-title">Fiche Stratégie</h1>
      </div>
    </header>

    <main>
      <section class="section">
        <div class="container">
          <h2 data-animate="fade-up">TEAMUP — connecter autour du sport</h2>
          <p class="lead" data-animate="fade-up">Courir, jouer, s’entraîner, découvrir des partenaires dans sa région.</p>

          <!-- À personnaliser -->
          <h3 data-animate="fade-up">SWOT</h3>
          <div class="grid-2">
            <div class="box" data-animate="fade-up">
              <h4>Forces</h4>
              <ul class="list">
                <li>Concept sport + lien social</li>
                <li>App intuitive & géolocalisée</li>
                <li>Partenariats (salles, assos, marques)</li>
                <li>Valeurs positives</li>
              </ul>
            </div>
            <div class="box" data-animate="fade-up">
              <h4>Faiblesses</h4>
              <ul class="list">
                <li>Masse critique au lancement</li>
                <li>Dépendance à la motivation</li>
                <li>Coûts de dev & maintenance</li>
                <li>Marché concurrentiel</li>
              </ul>
            </div>
          </div>

          <h3 data-animate="fade-up">Segmentation, Ciblage, Positionnement</h3>
          <ul class="list" data-animate="fade-up">
            <li>Zones urbaines/périurbaines, tous âges, familles</li>
            <li>Sport sans pression de club, motivation sociale</li>
            <li>Accessible, motivant, social; valeurs: Motivation, Accessibilité, Convivialité, Sécurité</li>
          </ul>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <small>© 2025 Team_Up</small>
    </footer>
  </body>
</html>
